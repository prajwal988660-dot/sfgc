# ============================================================================
#  SFGC Platform — root environment template
#  Copy the relevant blocks into each package's own .env file:
#    backend/.env         web/.env.local
#    apps/teacher-app/.env  apps/student-app/.env
# ============================================================================

# ---------------------------------------------------------------------------
# BACKEND  (backend/.env)
# ---------------------------------------------------------------------------
# Supabase Postgres connection strings.
# Dashboard -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL      : pooled connection (port 6543, pgbouncer) used at runtime.
# DIRECT_URL        : direct connection (port 5432) used by Prisma Migrate.
#
# Replace [PASSWORD] with your database password and keep the project ref.
DATABASE_URL="postgresql://postgres.omqvpahtcuwxpvdnxjlq:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.omqvpahtcuwxpvdnxjlq:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Secret used to sign JWTs. Generate with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Seed script admin bootstrap
SEED_ADMIN_EMAIL="admin@sfgc.ac.in"
SEED_ADMIN_PASSWORD="Admin@123"

# ---------------------------------------------------------------------------
# WEBSITE  (web/.env.local)
# ---------------------------------------------------------------------------
# Public API base URL used by the browser.
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Server-side base URL (used by React Server Components).
API_URL="http://localhost:4000/api"

# ---------------------------------------------------------------------------
# MOBILE APPS  (apps/teacher-app/.env and apps/student-app/.env)
# ---------------------------------------------------------------------------
# IMPORTANT: a phone cannot reach "localhost" — that is the phone itself.
# Use your computer's LAN IP (e.g. 192.168.1.5) while developing over Wi-Fi,
# or a deployed HTTPS URL for production APKs.
EXPO_PUBLIC_API_URL="http://192.168.1.5:4000/api"
