# Copy this file to `.env.local` and fill in your Supabase project values.
# Find them in your Supabase dashboard → Project Settings → API.
# The anon key is a public/publishable key (safe for the browser); it is
# protected by Row Level Security policies on the database.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
