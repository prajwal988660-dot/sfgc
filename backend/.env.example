# Copy to backend/.env and fill in.

# --- Supabase Postgres -------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string
#   DATABASE_URL : pooled  (port 6543, "Transaction" mode) — used at runtime
#   DIRECT_URL   : direct  (port 5432, "Session" mode)     — used by migrations
# Replace [PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.omqvpahtcuwxpvdnxjlq:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.omqvpahtcuwxpvdnxjlq:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Auth --------------------------------------------------------------------
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Browser origins allowed to call the API (comma separated).
# The mobile apps send no Origin header and are always allowed.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- Seed --------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@sfgc.ac.in"
SEED_ADMIN_PASSWORD="Admin@123"

# --- Image uploads (admin panel) ---------------------------------------------
# Optional. Without these the API runs normally and only /api/media/upload
# reports itself unconfigured, so the admin panel falls back to pasting a URL.
#
# Setup, all in the Supabase dashboard of the project above:
#   1. Storage -> New bucket -> name it "media" -> tick "Public bucket"
#   2. Project Settings -> API -> copy "Project URL" into SUPABASE_URL
#   3. Same page -> Project API keys -> reveal "service_role" -> copy it here
#
# The service_role key bypasses row-level security. It belongs on the server
# only: never put it in web/.env.local or any EXPO_PUBLIC_* variable, both of
# which are shipped to the client.
SUPABASE_URL="https://omqvpahtcuwxpvdnxjlq.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MEDIA_BUCKET="media"
