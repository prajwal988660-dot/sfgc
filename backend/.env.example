# Copy to backend/.env and fill in.

# --- Supabase Postgres -------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string
#   DATABASE_URL : pooled  (port 6543, "Transaction" mode) — used at runtime
#   DIRECT_URL   : direct  (port 5432, "Session" mode)     — used by migrations
# Replace [PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.omqvpahtcuwxpvdnxjlq:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.omqvpahtcuwxpvdnxjlq:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Auth --------------------------------------------------------------------
# Generate one with:  openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Browser origins allowed to call the API (comma separated).
# The mobile apps send no Origin header and are always allowed.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# --- Seed --------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@sfgc.ac.in"
SEED_ADMIN_PASSWORD="Admin@123"
