// =============================================================================
//  SFGC Platform — Prisma schema
//  Target: PostgreSQL (Supabase)
//
//  DATABASE_URL -> pooled connection (pgbouncer, port 6543) used at runtime
//  DIRECT_URL   -> direct connection (port 5432) used by Prisma Migrate
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- enums ----

/// Who someone is. What they may DO is decided by the permission map in
/// src/auth/permissions.ts, not by comparing against these names directly —
/// a role check scattered through a handler is a rule nobody can audit.
///
/// ADMIN is deprecated and retained only so the currently deployed API, which
/// still compares against it, keeps working while the roles are widened. It is
/// removed once every account has moved to SUPER_ADMIN and that build is live.
/// Postgres cannot drop an enum value in place, so removing it later means
/// swapping the type — see the migration that does it.
enum Role {
  ADMIN

  STUDENT
  TEACHER
  /// Site content: notices, events, gallery, updates.
  CONTENT_ADMIN
  /// Admission applications and their documents, and nothing else.
  ADMISSIONS_OFFICER
  /// Everything, including managing users and their roles.
  SUPER_ADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum NoticeAudience {
  ALL
  STUDENTS
  TEACHERS
}

enum RegistrationStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

/// What a piece of study material actually is. Students filter the library by
/// this, because "last year's question paper" and "the unit 3 notes" are
/// looked for in completely different situations.
enum MaterialKind {
  NOTES
  QUESTION_PAPER
  SOLVED_PAPER
  SYLLABUS
  REFERENCE
}

// ----------------------------------------------------------------- user ----

/// A single account table for all three roles. Role-specific columns are
/// nullable; which ones are required is enforced at the API validation layer
/// (see backend/src/validators) rather than in the database, so that a user's
/// role can be changed by an admin without a migration.
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String
  role         Role    @default(STUDENT)
  phone        String?
  avatarUrl    String?
  isActive     Boolean @default(true)

  // --- student fields ---
  /// College register number, e.g. "SFGC101". Unique when present.
  registerNo String? @unique
  /// Stream-scoped student ID, e.g. "BCA26001" — stream code, two-digit
  /// admission year, then a serial that restarts per stream. This is what
  /// attendance and the apps display. `registerNo` is kept alongside it so
  /// anything already recorded against the old numbering still resolves.
  studentCode String? @unique
  program    String? // "BCA", "B.Com", "MBA" ...
  semester   Int?
  section    String? // "A", "B" ...
  admissionYear Int?
  guardianName  String?
  guardianPhone String?

  /// Set for students once an admin files them into a class. Nullable because
  /// the 40 seeded students predate class groups, and because teachers and
  /// admins have neither.
  streamId     String?
  classGroupId String?
  stream       Stream?     @relation("StudentStream", fields: [streamId], references: [id], onDelete: SetNull)
  classGroup   ClassGroup? @relation("StudentClassGroup", fields: [classGroupId], references: [id], onDelete: SetNull)

  // --- teacher fields ---
  employeeId  String? @unique
  designation String? // "Assistant Professor" ...
  department  String? // shared by teachers and students

  /// Expo push token, set by the mobile apps so the backend can notify
  /// this user when a notice targeting them is published.
  expoPushToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- relations ---
  taughtSubjects     Subject[]           @relation("SubjectTeacher")
  enrolledSubjects   Subject[]           @relation("SubjectEnrollment")
  attendance         Attendance[]        @relation("StudentAttendance")
  attendanceMarked   Attendance[]        @relation("AttendanceMarkedBy")
  progressCards      ProgressCard[]      @relation("StudentProgress")
  progressRecorded   ProgressCard[]      @relation("ProgressRecordedBy")
  eventsCreated      Event[]             @relation("EventCreatedBy")
  eventRegistrations EventRegistration[] @relation("UserRegistrations")
  noticesAuthored    Notice[]            @relation("NoticeAuthor")
  materialsUploaded  StudyMaterial[]     @relation("MaterialUploadedBy")
  galleryUploaded    GalleryImage[]      @relation("GalleryUploadedBy")

  @@index([role])
  @@index([program, semester, section])
  @@index([classGroupId])
  @@index([streamId])
  @@map("users")
}

// --------------------------------------------------------------- stream ----

/// A programme of study — BCA, B.Com, BBA. Previously this lived only as a
/// free-text `program` string on User and Subject, which meant "B.Com",
/// "BCom" and "b.com" were three different classes. Making it a row gives the
/// admin something to create and delete, and gives student IDs a stable prefix.
model Stream {
  id   String @id @default(cuid())
  /// Uppercase, no punctuation — used as the student ID prefix, so "BCOM"
  /// rather than "B.Com".
  code String @unique
  name String
  /// The display form, e.g. "B.Com". `code` stays machine-friendly.
  shortName  String?
  department String?
  durationSemesters Int     @default(6)
  isActive          Boolean @default(true)

  classGroups ClassGroup[]
  students    User[]          @relation("StudentStream")
  materials   StudyMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("streams")
}

/// One teachable class: a stream, a semester and a section, for one academic
/// year. This is the thing an admin creates and then fills with students, and
/// the thing a teacher picks before marking attendance.
model ClassGroup {
  id           String @id @default(cuid())
  streamId     String
  semester     Int
  section      String
  academicYear String @default("2026-27")

  stream   Stream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  students User[] @relation("StudentClassGroup")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The same section cannot exist twice in one stream, semester and year.
  @@unique([streamId, semester, section, academicYear])
  @@index([streamId, semester])
  @@map("class_groups")
}

// --------------------------------------------------------------- period ----

/// A slot in the college's daily timetable. Defined once by the admin so a
/// teacher picks "Period 3" and the times come along with it, rather than
/// retyping 11:15 every day and eventually typing 11:51.
model Period {
  id     String @id @default(cuid())
  /// 1, 2, 3 … Attendance stores this number rather than the row id.
  number Int    @unique
  label  String?
  /// "HH:mm", 24-hour. Times of day with no date attached, so a string beats
  /// a DateTime whose date component would be meaningless and misleading.
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("periods")
}

// -------------------------------------------------------------- library ----

/// Notes, question papers and solved papers, shown in the student app's
/// library. Files live wherever `fileUrl` points — the admin panel uploads
/// them to Supabase Storage through /api/media/upload.
model StudyMaterial {
  id          String       @id @default(cuid())
  title       String
  description String?
  kind        MaterialKind @default(NOTES)
  fileUrl     String
  /// Shown next to the download link, e.g. "PDF · 2.4 MB".
  fileLabel   String?

  /// Scope. All three are optional: a material can target one subject, or a
  /// whole semester of a stream, or the entire college.
  streamId  String?
  semester  Int?
  subjectId String?

  isPublished Boolean @default(true)

  uploadedById String?

  stream     Stream?  @relation(fields: [streamId], references: [id], onDelete: SetNull)
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  uploadedBy User?    @relation("MaterialUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([streamId, semester])
  @@index([subjectId])
  @@index([kind])
  @@map("study_materials")
}

// -------------------------------------------------------------- gallery ----

/// A photograph on the public site.
///
/// Distinct from StudyMaterial, which is a file a student downloads: these are
/// images shown to visitors, ordered and grouped for display. The homepage's
/// existing "gallery" is a grid of facility icons drawn from static content —
/// this is the first place actual photographs of the college live.
model GalleryImage {
  id      String  @id @default(cuid())
  title   String
  caption String?
  /// Public URL. Uploaded through /api/media/upload, or pasted.
  imageUrl String
  /// Alternative text. Nullable rather than defaulted to the title, because a
  /// description written for a sighted reader is rarely the right alt text.
  altText String?

  /// Groups images into albums — "Campus", "Sambhram 2026", "NSS Camp".
  /// Free text rather than an enum: the albums a college wants are editorial
  /// and change every year, and a migration per fest would be absurd.
  album String @default("Campus")

  /// Ascending. Ties break on createdAt, so an album with every position left
  /// at 0 still comes back in a stable, sensible order rather than at random.
  sortOrder Int @default(0)

  isPublished Boolean @default(true)

  uploadedById String?
  uploadedBy   User?   @relation("GalleryUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The public listing filters on isPublished and orders within an album.
  @@index([isPublished, album, sortOrder])
  @@map("gallery_images")
}

// -------------------------------------------------------------- subject ----

/// A taught subject for one program + semester + section. The triple
/// (program, semester, section) is what the teacher app presents as a "class".
model Subject {
  id       String  @id @default(cuid())
  code     String  @unique // "BCA301"
  name     String // "Database Management Systems"
  program  String // "BCA"
  semester Int
  section  String? // "A"
  credits  Int     @default(4)
  department String?
  academicYear String @default("2026-27")
  isActive Boolean @default(true)

  teacherId String?
  teacher   User?   @relation("SubjectTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  /// Students enrolled in this subject. Implicit many-to-many; Prisma manages
  /// the join table. This is the roster the teacher app marks attendance on.
  students User[] @relation("SubjectEnrollment")

  attendance    Attendance[]
  progressCards ProgressCard[]
  materials     StudyMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([program, semester, section])
  @@map("subjects")
}

// ----------------------------------------------------------- attendance ----

/// One row per student, per subject, per period, per calendar day. The
/// composite unique key makes re-marking idempotent instead of duplicating.
///
/// `periodNumber` is the period's number rather than a foreign key, and it is
/// non-null with a default. A nullable FK in the unique key would defeat it
/// entirely: Postgres treats NULLs as distinct, so every unmarked-period row
/// would count as unique and the same student could be marked twice for the
/// same hour. Defaulting to 1 also lets the rows that predate periods keep
/// working untouched.
model Attendance {
  id           String           @id @default(cuid())
  studentId    String
  subjectId    String
  date         DateTime         @db.Date
  periodNumber Int              @default(1)
  status       AttendanceStatus
  remarks      String?

  markedById String
  markedBy   User   @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  student User    @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, date, periodNumber])
  @@index([subjectId, date])
  @@index([studentId])
  @@map("attendance")
}

// ---------------------------------------------------------------- event ----

model Event {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String   @default("Event") // "Fest", "Workshop", "Seminar", "Sports"
  startsAt    DateTime
  endsAt      DateTime?
  venue       String?
  coverImage  String?
  /// Registration fee in INR. 0 means free.
  fee         Int      @default(0)
  /// Null means unlimited seats.
  capacity    Int?
  registrationOpen Boolean @default(true)
  isPublished      Boolean @default(true)
  organizer    String?
  contactName  String?
  contactEmail String?
  contactPhone String?

  createdById String?
  createdBy   User?   @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt])
  @@index([isPublished])
  @@map("events")
}

/// Registrations accept both logged-in users (mobile apps) and anonymous
/// visitors (public website form), hence userId is optional but the contact
/// fields are always required.
model EventRegistration {
  id         String             @id @default(cuid())
  ticketCode String             @unique
  eventId    String
  userId     String?
  name       String
  email      String
  phone      String?
  college    String?
  teamName   String?
  /// Comma-separated additional participants for team events.
  teamMembers String?
  status     RegistrationStatus @default(CONFIRMED)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation("UserRegistrations", fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One registration per email per event.
  @@unique([eventId, email])
  @@index([eventId])
  @@index([userId])
  @@map("event_registrations")
}

// --------------------------------------------------------------- notice ----

model Notice {
  id       String         @id @default(cuid())
  title    String
  body     String
  category String         @default("General") // "Exam", "Event", "Holiday", "Placement"
  audience NoticeAudience @default(ALL)
  pinned   Boolean        @default(false)
  attachmentUrl String?
  /// Optional narrowing so a notice can target one program/semester only.
  program  String?
  semester Int?

  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  authorId String
  author   User   @relation("NoticeAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([audience, publishedAt])
  @@index([pinned])
  @@map("notices")
}

// --------------------------------------------------------- progress card ----

/// One row per student, per subject, per semester — a single line on the
/// printed progress card. The API aggregates these rows into a card with
/// totals, percentage and SGPA.
model ProgressCard {
  id           String @id @default(cuid())
  studentId    String
  subjectId    String
  semester     Int
  academicYear String @default("2026-27")

  internalMarks Int?
  maxInternal   Int  @default(40)
  externalMarks Int?
  maxExternal   Int  @default(60)
  grade         String?
  credits       Int  @default(4)
  remarks       String?

  isPublished Boolean @default(false)

  recordedById String?
  recordedBy   User?   @relation("ProgressRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  student User    @relation("StudentProgress", fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, subjectId, semester, academicYear])
  @@index([studentId, semester])
  @@map("progress_cards")
}
