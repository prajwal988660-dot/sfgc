# dependencies
node_modules/
.pnp
.pnp.js

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# env
# `.env.*` rather than a list: a stray .env.bak or .env.old holds the same
# database password as the real thing, and the previous rules did not cover
# them. The negation below keeps the committed template visible.
.env
.env.*
!.env.example

# expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
android/
ios/

# app signing — a leaked keystore lets anyone publish an update that phones
# will accept as genuine. Never commit these.
credentials/
*.keystore
signing.properties

# built apps
*.apk
*.aab

# eas
.easignore

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# misc
.DS_Store
Thumbs.db
.vscode/
.idea/
coverage/

# prisma
prisma/*.db
prisma/*.db-journal

# Stray editor scratch files. One of these leaked a live database URI.
Untitled
Untitled.*
