# Copy to .env in this folder.
#
# A phone cannot reach "localhost" — that address means the phone itself.
# During development use your computer's LAN IP so the device on the same
# Wi-Fi can reach the API:
#   Windows: ipconfig      macOS/Linux: ifconfig
# After changing this, restart the bundler with a cleared cache:
#   npx expo start -c
#
# For a real APK, point this at your deployed HTTPS API instead — and remember
# eas.json sets its own EXPO_PUBLIC_API_URL per build profile, which wins.
EXPO_PUBLIC_API_URL=http://192.168.1.5:4000/api
